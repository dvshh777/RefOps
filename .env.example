# PORT: Application server port (default: 3000)
PORT=3000

# NODE_ENV: Runtime environment (development | production)
NODE_ENV=development

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# MONGODB_URI: Connection string for MongoDB document database.
# Default connects to local MongoDB instance: mongodb://localhost:27017/oroc_refinery
MONGODB_URI="mongodb://localhost:27017/oroc_refinery"

# REDIS_URL: Connection URL for Redis cache and pubsub telemetry.
REDIS_URL="redis://localhost:6379"

# DISABLE_HMR: Disables Vite HMR in AI Studio preview to prevent flickering during edits.
DISABLE_HMR=true

# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

